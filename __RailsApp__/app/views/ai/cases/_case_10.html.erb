<div class="ah-case-card">
  <div class="ah-case-number">10</div>
  <h2 class="ah-case-name">YouTube Audio Download</h2>
  <p class="ah-case-desc">
    Paste a YouTube URL, watch a live progress bar as the standalone
    <code>youtube_stream</code> container downloads the audio track in the
    background. Download only for now &mdash; transcription comes later.
  </p>
  <ul class="ah-case-tags">
    <li>yt-dlp</li>
    <li>background job</li>
    <li>polling</li>
  </ul>
  <%= link_to "Try it →", ai_requests_youtube_path, class: "ah-case-btn" %>
</div>
